# ============================================================================
# Настройки для хостинга: сжатие и кеширование.
#
# Что это даёт: браузер запоминает картинки, шрифты и стили, и при повторном
# заходе сайт открывается почти мгновенно. Плюс файлы передаются сжатыми —
# это примерно втрое меньше трафика на текстовых файлах.
#
# Файл начинается с точки, поэтому некоторые программы его прячут.
# В FileZilla включите «Сервер» → «Принудительно отображать скрытые файлы».
#
# Работает на хостингах с Apache — это почти все обычные хостинги в России.
# Если хостинг на nginx, файл просто ничего не сделает: попросите поддержку
# включить сжатие gzip и кеширование статики.
# ============================================================================


# --- 1. Сжатие -------------------------------------------------------------
# Текстовые файлы передаются в сжатом виде. Картинки и шрифты webp/woff2
# сжаты сами по себе, их трогать не надо.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>


# --- 2. Кеширование --------------------------------------------------------
# Сколько браузеру разрешено помнить файл, не спрашивая сервер заново.
#
# ВАЖНО про правки: картинки и стили закешированы надолго. Если вы заменили
# фото или поправили style.css, а на сайте всё по-старому — нажмите
# Ctrl+F5 (на Маке Cmd+Shift+R). У обычных посетителей всё обновится само,
# когда кеш истечёт. Чтобы обновилось сразу у всех, переименуйте файл:
# style.css → style-2.css, и поправьте ссылку в index.html.
#
# content.js намеренно кешируется всего на час: это файл, который вы правите
# чаще всего, и правки должны доходить до людей быстро.

<IfModule mod_expires.c>
  ExpiresActive On

  # Картинки и иконки — год
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"

  # Шрифты — год
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"

  # Звук — месяц
  ExpiresByType audio/mpeg                "access plus 1 month"

  # Стили и скрипты — месяц
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"

  # Сама страница — не кешируется, всегда свежая
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

# Тексты сайта обновляются чаще остальных файлов
<Files "content.js">
  <IfModule mod_expires.c>
    ExpiresDefault "access plus 1 hour"
  </IfModule>
</Files>


# --- 3. Типы файлов --------------------------------------------------------
# Некоторые старые хостинги не знают webp и woff2 и отдают их неправильно.

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>


# --- 4. Кодировка ----------------------------------------------------------
# Чтобы русский текст не превращался в «Ð¿ÑÐ¸Ð²ÐµÑ».

AddDefaultCharset UTF-8


# ============================================================================
# --- 5. Переезд на https и адрес без www -----------------------------------
#
# ЭТИ ДВА БЛОКА ВЫКЛЮЧЕНЫ. Включайте их только после того, как подключили
# бесплатный сертификат в панели хостинга и убедились, что сайт открывается
# по адресу с https. Если включить раньше — сайт перестанет открываться.
#
# Чтобы включить: уберите знак # в начале строк нужного блока.
# ============================================================================

# --- Всегда открывать сайт по https ---
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# --- Адрес без www (site.ru вместо www.site.ru) ---
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
#   RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [L,R=301]
# </IfModule>
